---
layout: layouts/base.njk
---
<article class="h-entry">
  <h1 class="p-name">{{ title }}</h1>
  <div class="e-content">
    {{ content | safe }}
  </div>

  {%- set subpages = collections.pages | childrenOf(page.url) %}
  {%- if subpages.length %}
  <nav class="subpages">
    <h2>In this section</h2>
    <ul>
      {%- for subpage in subpages %}
      <li><a href="{{ subpage.url }}">{{ subpage.data.title }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
  {%- endif %}
</article>
