---
layout: layouts/base.njk
pagination:
  data: categoryNames
  size: 1
  alias: slug
  filter:
    - uncategorized
eleventyComputed:
  title: "{{ categoryNames[slug] }}"
permalink: "/category/{{ slug }}/"
---
<h1>Category: {{ categoryNames[slug] }}</h1>
<ul class="archive-list">
  {%- for post in collections.posts | reverse | inCategory(slug) %}
  <li><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time> <a href="{{ post.url }}">{{ post.data.title }}</a></li>
  {%- endfor %}
</ul>
